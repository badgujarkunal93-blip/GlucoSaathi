{
  "name": "glucosaathi-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:ml": "PYTHONPATH=ml ml/.venv/bin/uvicorn src.service.api:app --host 0.0.0.0 --port 8000",
    "build": "npm run build --workspace=frontend",
    "test": "vitest run",
    "test:ml": "PYTHONPATH=ml ml/.venv/bin/pytest ml/tests"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
